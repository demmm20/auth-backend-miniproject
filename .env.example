# Database Configuration
MONGODB_URI=mongodb://localhost:27017/auth-nestjs

# JWT Secrets
# IMPORTANT: Change these to strong, random values in production!
# You can generate secure secrets using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your-super-secret-access-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production

# JWT Token Expiry
# Access token should be short-lived (15m = 15 minutes)
# Refresh token can be longer (7d = 7 days)
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Application Configuration
PORT=3000
NODE_ENV=development